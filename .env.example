# ==============================================================================
# Beherit Environment Configuration Template
# Copy this file to .env and adjust variables to your environment.
# NEVER commit .env to version control!
# ==============================================================================

# Server Network Settings
BEHERIT_HOST=0.0.0.0
BEHERIT_PORT=8650
BEHERIT_ENV=development

# Security & Encryption Key (Generate a random string: openssl rand -hex 32)
BEHERIT_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars

# Storage Paths
BEHERIT_DATA_DIR=./data
# Custom Agent Directory (Uncomment to store agents in an Obsidian Vault or external folder)
# BEHERIT_AGENTS_DIR=/path/to/your/obsidian/vault/Agents
BEHERIT_DB_PATH=./data/beherit.db

# CORS Allowed Origins (Comma-separated or JSON array)
BEHERIT_CORS_ORIGINS=["*"]

# Optional Database Connector for Agent Tools (PostgreSQL/MySQL/SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Optional Multi-Channel Telegram Alerts for Scheduled Jobs
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=123456789
